# Configuration OIDC publique pour une application Vue/Vite.
# Toutes les variables VITE_* sont exposées dans le bundle : ne jamais y placer de secret.

# Fournir soit l'issuer complet :
VITE_IAM_AUTHORITY=https://sso.example.org/realms/app
# soit l'URL de l'IdP et le realm (laisser VITE_IAM_AUTHORITY vide ou le commenter) :
# VITE_IAM_URL=https://sso.example.org
# VITE_IAM_REALM=app

# Identifiant du client public enregistré auprès de l'IdP.
VITE_IAM_CLIENT_ID=app-public

# Ces URL doivent être autorisées exactement dans la configuration du client IdP.
VITE_IAM_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_IAM_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_IAM_SILENT_REDIRECT_URI=http://localhost:5173/silent-renew.html

# Options facultatives.
VITE_IAM_SCOPE=openid profile email
VITE_IAM_STORAGE=memory
VITE_IAM_DEBUG=false
