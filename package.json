{
  "name": "authentification-vue-oidc",
  "version": "0.1.0",
  "description": "Librairie d'authentification OIDC pour Vue 3",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "types",
    "docs"
  ],
  "workspaces": [
    "demos/advanced",
    "demos/simple"
  ],
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type": "tsc --noEmit",
    "docs": "typedoc",
    "lint": "eslint src",
    "test": "vitest run",
    "publish": "npm pack",
    "test:coverage": "vitest run --coverage",
    "check:source-size": "node scripts/check-source-lines.js",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "ci": "npm run lint && npm test && npm run type && npm run check:source-size && npm run check:bundle-size && npm audit"
  },
  "dependencies": {
    "oidc-client-ts": "^3.2.1",
    "vue-logger-plugin": "^2.2.3"
  },
  "peerDependencies": {
    "vue": ">=3.4.0",
    "vue-router": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  }
}
